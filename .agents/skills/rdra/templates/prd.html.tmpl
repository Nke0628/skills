<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>__TITLE__</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&family=Shippori+Mincho+B1:wght@600;800&display=swap">
<style>
  /* 左に目次、右に本文。会議で画面共有して上から順に読み合わせる資料 */
  :root {
    --paper: #f5f7f6; --surface: #ffffff; --ink: #18232e; --muted: #5a6773; --line: #d7dfe1;
    --accent: #0d6b67; --accent-soft: #e2f0ee;
    --ok: #256b43; --ok-bg: #e3f1e8; --hyp: #8a5200; --hyp-bg: #fbeed6;
    --src: #3f5a74; --src-bg: #e6edf4; --high: #a8291f; --high-bg: #fbe6e3; --mid: #8a5200; --mid-bg: #fbeed6;
    --k-actor: #3b6fb6; --k-actor-bg: #e6eefa; --k-screen: #2a8199; --k-screen-bg: #e3f3f6;
    --k-uc: #0d6b67; --k-uc-bg: #e2f0ee; --k-ext: #7a52b3; --k-ext-bg: #efe8f8;
    --k-info: #a87410; --k-info-bg: #fbf1d9; --k-cond: #b54a5e; --k-cond-bg: #fbe7ea; --k-state: #5a6773; --k-state-bg: #ebedf0;
    --display: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho", serif;
    --body: "BIZ UDPGothic", "Hiragino Sans", "Yu Gothic", "Noto Sans JP", sans-serif;
    --mono: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #10171c; --surface: #172027; --ink: #e4eaee; --muted: #98a6b1; --line: #29353f;
      --accent: #56c2b8; --accent-soft: #15302e;
      --ok: #82cfa0; --ok-bg: #173022; --hyp: #f0b860; --hyp-bg: #33270f;
      --src: #a5bdd4; --src-bg: #1c2935; --high: #f4938a; --high-bg: #3a1d1a; --mid: #f0b860; --mid-bg: #33270f;
      --k-actor: #7fa8e6; --k-actor-bg: #172640; --k-screen: #5cc0d6; --k-screen-bg: #12303a;
      --k-uc: #56c2b8; --k-uc-bg: #15302e; --k-ext: #b597e6; --k-ext-bg: #261d3a;
      --k-info: #e3b55c; --k-info-bg: #33280f; --k-cond: #ef93a5; --k-cond-bg: #3a1a22; --k-state: #98a6b1; --k-state-bg: #222b33;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --paper: #10171c; --surface: #172027; --ink: #e4eaee; --muted: #98a6b1; --line: #29353f;
    --accent: #56c2b8; --accent-soft: #15302e;
    --ok: #82cfa0; --ok-bg: #173022; --hyp: #f0b860; --hyp-bg: #33270f;
    --src: #a5bdd4; --src-bg: #1c2935; --high: #f4938a; --high-bg: #3a1d1a; --mid: #f0b860; --mid-bg: #33270f;
    --k-actor: #7fa8e6; --k-actor-bg: #172640; --k-screen: #5cc0d6; --k-screen-bg: #12303a;
    --k-uc: #56c2b8; --k-uc-bg: #15302e; --k-ext: #b597e6; --k-ext-bg: #261d3a;
    --k-info: #e3b55c; --k-info-bg: #33280f; --k-cond: #ef93a5; --k-cond-bg: #3a1a22; --k-state: #98a6b1; --k-state-bg: #222b33;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; background: var(--paper); color: var(--ink); font: 15px/1.75 var(--body); }
  .wrap { max-width: 1120px; margin: 0 auto; padding-inline: 16px; padding-block: 32px 80px;
    display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; }
  nav.toc { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 24px); align-self: start;
    display: flex; flex-direction: column; gap: 2px; font-size: 13px; }
  nav.toc a { color: var(--muted); text-decoration: none; padding: 5px 10px; border-left: 2px solid var(--line); }
  nav.toc a:hover, nav.toc a:focus-visible { color: var(--accent); border-left-color: var(--accent); outline: none; }
  main { min-width: 0; max-width: 820px; }
  .eyebrow { font-size: 12px; letter-spacing: .08em; color: var(--accent); font-weight: 700; }
  h1 { font-family: var(--display); font-weight: 800; font-size: 40px; line-height: 1.2; margin: 6px 0 4px; text-wrap: balance; }
  .meta { color: var(--muted); font-size: 13px; }
  .stats { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .stats span { display: inline-flex; align-items: baseline; gap: 6px; padding: 6px 12px; background: var(--surface);
    border: 1px solid var(--line); border-radius: 6px; font-size: 13px; color: var(--muted); }
  .stats b { font-size: 18px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stats .warn b { color: var(--hyp); }
  details.guide { margin-top: 14px; font-size: 13px; }
  details.guide summary { cursor: pointer; color: var(--accent); }
  details.guide dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 14px; margin: 10px 0 0;
    padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
  details.guide dt { font-weight: 700; display: flex; gap: 4px; align-items: center; }
  details.guide dd { margin: 0; color: var(--muted); }
  section { margin-top: 48px; scroll-margin-top: 16px; }
  h2 { font-family: var(--display); font-weight: 800; font-size: 25px; margin: 0 0 6px; padding-bottom: 8px;
    border-bottom: 2px solid var(--ink); text-wrap: balance; }
  h3 { font-size: 16px; margin: 26px 0 10px; display: flex; align-items: baseline; gap: 8px; }
  h4 { font-size: 14px; margin: 18px 0 8px; color: var(--muted); }
  .lead { color: var(--muted); font-size: 14px; margin: 8px 0 16px; }
  .kind { font-size: 11px; font-weight: 400; color: var(--muted); letter-spacing: .06em; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; min-width: 0; }
  .card p { margin: 6px 0; }
  .card-h, .step-h, .rtitle, .oq-h { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .badge { font-size: 11px; padding: 1px 7px; border-radius: 999px; white-space: nowrap; line-height: 1.7; }
  .badge.ok { background: var(--ok-bg); color: var(--ok); }
  .badge.hyp { background: var(--hyp-bg); color: var(--hyp); font-weight: 700; }
  .badge.src { background: var(--src-bg); color: var(--src); }
  .chip { display: inline-block; font-size: 12px; padding: 1px 8px; margin: 2px 4px 2px 0; border: 1px solid var(--line);
    border-radius: 4px; background: var(--surface); }
  .chip.who { background: var(--accent-soft); border-color: transparent; color: var(--accent); font-weight: 700; }
  .chip.req { font-family: var(--mono); font-size: 11px; }
  .qref { font-family: var(--mono); font-size: 11px; color: var(--accent); text-decoration: none; border-bottom: 1px dotted var(--accent); }
  .sub { font-size: 12.5px; color: var(--muted); margin-top: 4px; }
  .none { color: var(--muted); font-size: 13px; }
  ul.reqs { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  ul.reqs li { display: flex; gap: 12px; padding: 12px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  ul.bg { margin: 0; padding-left: 1.2em; line-height: 1.7; }
  .rid { font-family: var(--mono); font-size: 12px; color: var(--muted); padding-top: 2px; min-width: 3.2em; }
  .rbody { min-width: 0; }
  .rtitle { font-weight: 700; }
  .rdesc { color: var(--muted); font-size: 13.5px; }
  .flow { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; margin-bottom: 14px; }
  .flow-h { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; align-items: baseline; font-size: 15.5px; }
  ol.steps { list-style: none; counter-reset: s; padding: 0; margin: 12px 0 0; }
  ol.steps > li { counter-increment: s; position: relative; padding: 0 0 14px 38px; }
  ol.steps > li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 24px; height: 24px; border-radius: 50%;
    background: var(--ink); color: var(--paper); font-size: 12px; display: grid; place-items: center; font-variant-numeric: tabular-nums; }
  ol.steps > li:not(:last-child)::after { content: ""; position: absolute; left: 11px; top: 28px; bottom: 2px; width: 2px; background: var(--line); }
  .step-name { font-weight: 700; }
  .tbl { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
  th, td { text-align: left; vertical-align: top; padding: 9px 12px; border-bottom: 1px solid var(--line); }
  th { font-size: 12px; color: var(--muted); font-weight: 700; background: var(--paper); }
  tr:last-child td { border-bottom: 0; }
  td.nowrap { white-space: nowrap; }
  ul.rels, ul.trans { padding-left: 20px; margin: 8px 0; }
  .mult { font-size: 12px; color: var(--muted); }
  .cond-tbl { margin-top: 8px; }
  .cond-tbl tbody th { background: var(--paper); white-space: nowrap; }
  .states { display: flex; flex-wrap: wrap; gap: 8px; }
  .state { display: inline-flex; gap: 6px; align-items: center; padding: 6px 12px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--surface); font-weight: 700; }
  ul.decisions { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  ul.decisions li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 16px; }
  .dq { font-size: 13.5px; }
  .da { font-weight: 700; color: var(--ok); font-size: 13.5px; }
  .qid { font-family: var(--mono); font-size: 11px; color: var(--muted); margin-right: 8px; }
  .oq { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; margin-bottom: 14px; scroll-margin-top: 16px; }
  .pri { font-size: 11px; padding: 1px 8px; border-radius: 4px; font-weight: 700; }
  .pri.high { background: var(--high-bg); color: var(--high); }
  .pri.mid { background: var(--mid-bg); color: var(--mid); }
  .pri.low { background: var(--src-bg); color: var(--src); }
  .oq dl { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; font-size: 13.5px; margin: 10px 0; }
  .oq dt { color: var(--muted); }
  .oq dd { margin: 0; }
  ol.choices { font-size: 13.5px; margin: 0; padding-left: 20px; list-style: none; }
  .memo { margin-top: 10px; display: flex; gap: 8px; align-items: flex-start; }
  .memo label { font-size: 11px; color: var(--muted); padding-top: 7px; white-space: nowrap; }
  .memo textarea { flex: 1; min-width: 0; font: inherit; font-size: 13.5px; color: var(--ink); background: var(--paper);
    border: 1px dashed var(--line); border-radius: 6px; padding: 6px 10px; resize: vertical; min-height: 34px; }
  .memo textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-style: solid; }
  .memo textarea.filled { border-style: solid; border-color: var(--accent); background: var(--surface); }
  .mbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  button { font: inherit; font-size: 14px; padding: 8px 16px; border-radius: 6px; border: 1px solid var(--accent);
    background: var(--accent); color: var(--paper); cursor: pointer; font-weight: 700; }
  button.ghost { background: transparent; color: var(--muted); border-color: var(--line); font-weight: 400; }
  button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  #msg { font-size: 13px; color: var(--ok); }
  pre.out { white-space: pre-wrap; font-family: var(--mono); font-size: 12.5px; background: var(--surface);
    border: 1px solid var(--line); border-radius: 8px; padding: 14px; min-height: 60px; overflow-x: auto; }
  code { font-family: var(--mono); font-size: 12.5px; }
  figure.dg { margin: 12px 0 16px; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; overflow-x: auto; }
  .flow figure.dg { border: 0; padding: 4px 0; margin: 8px 0; }
  figure.dg pre.mermaid { margin: 0; text-align: center; font-family: var(--body); font-size: 12px; color: var(--muted); white-space: pre-wrap; }
  figure.dg svg { max-width: 100%; height: auto; }
  /* UC複合図で中身を見られる要素(情報・条件・状態モデル)と、その中身を出す小窓 */
  figure.dg .node.has-detail { cursor: pointer; }
  figure.dg .node.has-detail:hover > :not(.label), figure.dg .node.has-detail:focus-visible > :not(.label) { stroke-width: 2.5px !important; }
  figure.dg .node.has-detail:focus { outline: none; }
  dialog.dg-pop { width: min(560px, calc(100vw - 32px)); max-height: min(80vh, 640px); padding: 0; border: 1px solid var(--line); border-radius: 10px;
    background: var(--surface); color: var(--ink); box-shadow: 0 12px 40px rgba(0,0,0,.25); }
  dialog.dg-pop[open] { display: flex; flex-direction: column; }
  dialog.dg-pop .pop-close:focus:not(:focus-visible) { outline: none; }
  dialog.dg-pop::backdrop { background: rgba(10, 16, 20, .35); }
  dialog.dg-pop .pop-h { display: flex; align-items: center; gap: 8px; padding: 14px 16px 10px; border-bottom: 1px solid var(--line); }
  dialog.dg-pop .pop-kind { font-size: 12px; color: var(--muted); }
  dialog.dg-pop .pop-title { font-weight: 700; font-size: 16px; flex: 1; }
  dialog.dg-pop .pop-close { border: 0; background: none; color: var(--muted); font-size: 20px; line-height: 1; cursor: pointer; padding: 4px 6px; }
  dialog.dg-pop .pop-b { padding: 12px 16px 16px; font-size: 14px; overflow-y: auto; }
  dialog.dg-pop dl { display: grid; grid-template-columns: max-content 1fr; gap: 8px 14px; margin: 0; }
  dialog.dg-pop dt { color: var(--muted); font-size: 13px; }
  dialog.dg-pop dd { margin: 0; }
  dialog.dg-pop ul.trans { margin: 0; padding-left: 18px; }
  @media (max-width: 520px) { dialog.dg-pop dl { grid-template-columns: 1fr; } dialog.dg-pop dd { margin-bottom: 4px; } }
  /* UC複合図の種類ごとの色。図の記述の色(明るい色だけ)ではなく、ここで両方のテーマに合わせて塗る */
  figure.dg .node.kActor > :not(.label) { fill: var(--k-actor-bg) !important; stroke: var(--k-actor) !important; }
  figure.dg .node.kScreen > :not(.label) { fill: var(--k-screen-bg) !important; stroke: var(--k-screen) !important; }
  figure.dg .node.kUc > :not(.label) { fill: var(--k-uc-bg) !important; stroke: var(--k-uc) !important; }
  figure.dg .node.kExt > :not(.label) { fill: var(--k-ext-bg) !important; stroke: var(--k-ext) !important; }
  figure.dg .node.kInfo > :not(.label) { fill: var(--k-info-bg) !important; stroke: var(--k-info) !important; }
  figure.dg .node.kCond > :not(.label) { fill: var(--k-cond-bg) !important; stroke: var(--k-cond) !important; }
  figure.dg .node.kState > :not(.label) { fill: var(--k-state-bg) !important; stroke: var(--k-state) !important; }
  figure.dg figcaption { font-size: 12px; color: var(--muted); margin-top: 8px; }
  details.more { margin-top: 6px; }
  details.more > summary { cursor: pointer; font-size: 13px; color: var(--accent); }
  details.more ol.steps, details.more ul.trans { margin-top: 10px; }
  @media (max-width: 860px) {
    .wrap { grid-template-columns: minmax(0, 1fr); gap: 0; padding-block: 20px 60px; }
    nav.toc { position: static; flex-direction: row; flex-wrap: wrap; gap: 4px; margin-bottom: 20px; }
    nav.toc a { border: 1px solid var(--line); border-radius: 999px; padding: 2px 10px; }
    h1 { font-size: 30px; }
    ul.decisions li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
</style>
</head>
<body>
<div class="wrap">
<nav class="toc" aria-label="目次"><!--__TOC__--></nav>
<main>
<!--__HEADER__-->
<!--__BODY__-->
</main>
</div>
<dialog class="dg-pop" id="dg-pop" aria-labelledby="dg-pop-title">
  <div class="pop-h"><span class="pop-kind" id="dg-pop-kind"></span><span class="pop-title" id="dg-pop-title"></span>
    <button class="pop-close" type="button" aria-label="閉じる">×</button></div>
  <div class="pop-b" id="dg-pop-body"></div>
</dialog>
<!--mermaid:start-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.9.1/mermaid.min.js"></script>
<script>
(function () {
  if (!window.mermaid) return;
  var cs = getComputedStyle(document.documentElement);
  function v(n) { return cs.getPropertyValue(n).trim(); }
  var dark = cs.getPropertyValue("color-scheme").indexOf("dark") >= 0;
  mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: "base", fontFamily: v("--body"),
    themeVariables: { darkMode: dark, background: v("--surface"), primaryColor: v("--accent-soft"), primaryTextColor: v("--ink"),
      primaryBorderColor: v("--accent"), lineColor: v("--muted"), secondaryColor: v("--paper"), tertiaryColor: v("--paper"),
      clusterBkg: v("--paper"), clusterBorder: v("--line"), edgeLabelBackground: v("--surface"), fontSize: "13px" } });
  // UC複合図の情報・条件・状態モデルを押すと、中身を小窓に出す
  var details = {};
  try { details = JSON.parse(document.getElementById("dg-details").textContent); } catch (e) {}
  var pop = document.getElementById("dg-pop");
  pop.querySelector(".pop-close").addEventListener("click", function () { pop.close(); });
  pop.addEventListener("click", function (ev) { if (ev.target === pop) pop.close(); });
  function show(key) {
    var i = key.indexOf(":");
    document.getElementById("dg-pop-kind").textContent = key.slice(0, i);
    document.getElementById("dg-pop-title").textContent = key.slice(i + 1);
    document.getElementById("dg-pop-body").innerHTML = details[key];
    pop.showModal();
  }
  function wire(pre) {
    var fig = pre.closest("figure"), keys;
    try { keys = JSON.parse(fig.getAttribute("data-keys") || "null"); } catch (e) { keys = null; }
    if (!keys) return;
    [].forEach.call(pre.querySelectorAll("g.node"), function (g) {
      var m = /flowchart-([A-Za-z]+\d+)-\d+$/.exec(g.id || ""), key = m && keys[m[1]];
      if (!key || !details[key]) return;
      g.classList.add("has-detail");
      g.setAttribute("tabindex", "0");
      g.setAttribute("role", "button");
      g.setAttribute("aria-label", key.replace(":", " ") + " の中身を見る");
      g.addEventListener("click", function () { show(key); });
      g.addEventListener("keydown", function (ev) { if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); show(key); } });
    });
  }
  // 閉じた details の中の図は大きさを測れず崩れるので、開いたときに描く。
  // mermaid.run は呼ぶたびに id を振り直して前の図とぶつかるので、id を振って1枚ずつ描く
  var seq = 0, queue = Promise.resolve();
  function draw(root) {
    [].forEach.call(root.querySelectorAll("pre.mermaid:not([data-processed])"), function (n) {
      var d = n.closest("details");
      if (d && !d.open) return;
      n.setAttribute("data-processed", "true");
      queue = queue.then(function () {
        return mermaid.render("dg" + (++seq), n.textContent).then(function (r) { n.innerHTML = r.svg; wire(n); });
      }).catch(function () { n.removeAttribute("data-processed"); });
    });
  }
  document.addEventListener("toggle", function (ev) { if (ev.target.open) draw(ev.target); }, true);
  draw(document);
})();
</script>
<!--mermaid:end-->
<script>
(function () {
  var STORE = "__STORE__";
  function load() { try { return JSON.parse(localStorage.getItem(STORE) || "{}"); } catch (e) { return {}; } }
  function save(v) { try { localStorage.setItem(STORE, JSON.stringify(v)); } catch (e) {} }
  var memos = load();
  var areas = Array.prototype.slice.call(document.querySelectorAll(".memo textarea"));
  var out = document.getElementById("out");
  var msg = document.getElementById("msg");
  function grow(t) { t.style.height = "auto"; t.style.height = t.scrollHeight + 2 + "px"; t.classList.toggle("filled", !!t.value.trim()); }
  function render() {
    var today = new Date();
    var lines = ["# 議事メモ(" + today.getFullYear() + "-" + String(today.getMonth() + 1).padStart(2, "0") + "-" + String(today.getDate()).padStart(2, "0") + ")", ""];
    var n = 0;
    areas.forEach(function (t) {
      var v = t.value.trim();
      if (!v) return;
      n++;
      lines.push("## " + t.dataset.label, "", v, "");
    });
    out.textContent = n ? lines.join("\n") : "まだメモはありません。各項目の「メモ」欄に書くと、ここにまとまります。";
    return n ? lines.join("\n") : "";
  }
  areas.forEach(function (t) {
    t.value = memos[t.dataset.key] || "";
    grow(t);
    t.addEventListener("input", function () {
      memos[t.dataset.key] = t.value;
      save(memos); grow(t); render();
    });
  });
  render();
  document.getElementById("copy").addEventListener("click", function () {
    var text = render();
    if (!text) { msg.textContent = "コピーするメモがありません"; return; }
    function fallback() {
      var r = document.createRange(); r.selectNodeContents(out);
      var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
      msg.textContent = "選択しました。Ctrl+C(⌘C)でコピーしてください";
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function () { msg.textContent = "コピーしました"; }, fallback);
    } else { fallback(); }
  });
  var clearBtn = document.getElementById("clear"), armed = false;
  clearBtn.addEventListener("click", function () {
    if (!armed) { armed = true; clearBtn.textContent = "もう一度押すと消します"; setTimeout(function () { armed = false; clearBtn.textContent = "メモをすべて消す"; }, 4000); return; }
    armed = false; clearBtn.textContent = "メモをすべて消す";
    memos = {}; save(memos);
    areas.forEach(function (t) { t.value = ""; grow(t); });
    render(); msg.textContent = "メモを消しました";
  });
})();
</script>
</body>
</html>
